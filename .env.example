# Lovable Cloud injects the Supabase vars automatically in the Lovable editor
# and in deployed builds. Copy this file to `.env` only if you want to run
# `npm run dev` locally against the real database.
#
# Find them in the Lovable editor under Cloud → Settings.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# The public origin this page is served from, no trailing slash.
# Baked into og:url, og:image and <link rel="canonical"> at build time, because
# social scrapers can't resolve relative URLs and don't run JS.
# Falls back to the Lovable preview URL — set this to the real domain before
# the ad goes live, or shared links will point at the preview.
VITE_SITE_URL=https://your-domain.com
